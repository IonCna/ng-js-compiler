{
  "name": "ng-js-compiler",
  "version": "0.1.0",
  "description": "Compilador fuente-a-fuente: lee decoradores de Angular real (@Component/@Directive/@Pipe/@Injectable/@NgModule) y los traduce a AngularJS — sin runtime propio.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": ["dist"],
  "license": "MIT",
  "author": "Max Flores",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@swc/core": "^1.16.2"
  },
  "peerDependencies": {
    "angular": "1.8.3",
    "esbuild": ">=0.20.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@types/angular": "^1.8.9",
    "@types/bun": "latest",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "angular": "1.8.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
